{
  "manifest_version": 3,
  "name": "Downs",
  "version": "2.1.0",
  "description": "Detect HLS playlists and directly save supported MPEG-TS VOD streams as MP4.",
  "permissions": ["downloads", "storage", "tabs", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "scripts": ["hls-parser.js", "download-core.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Inspect HLS streams with Downs"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "downs-link-sucker@downs.local",
      "strict_min_version": "115.0"
    }
  }
}
