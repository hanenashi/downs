{
  "manifest_version": 3,
  "name": "Downs",
  "version": "2.9.0",
  "description": "Detect HLS streams, assemble supported VOD as MP4, and manage private downloads.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["declarativeNetRequestWithHostAccess", "downloads", "storage", "tabs", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Inspect HLS streams with Downs"
  }
}
