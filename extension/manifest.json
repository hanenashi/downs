{
  "manifest_version": 3,
  "name": "Downs",
  "version": "2.7.0",
  "description": "Detect HLS streams, assemble supported VOD as MP4, and manage private downloads.",
  "permissions": ["declarativeNetRequestWithHostAccess", "downloads", "storage", "tabs", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Inspect HLS streams with Downs"
  }
}
